# Historical projects, raw backups and compiler binaries stay local
/FPGAProjects/_archive/
/FPGAProjects/tools/*
!/FPGAProjects/tools/README.md
/FPGAProjects/docs/工程迁移_20261006/
/FPGAProjects/StyleCam_camera/results/camera_failure.json

# Compact acceptance records needed for the complete board project
!/FPGAProjects/StyleCam_camera/validation/
/FPGAProjects/StyleCam_camera/validation/*
!/FPGAProjects/StyleCam_camera/validation/source_sha256.json
!/FPGAProjects/StyleCam_camera/validation/compact_IN.json
!/FPGAProjects/StyleCam_camera/validation/in_constants.json
!/FPGAProjects/StyleCam_camera/validation/video_engine/
/FPGAProjects/StyleCam_camera/validation/video_engine/*
!/FPGAProjects/StyleCam_camera/validation/video_engine/result.json
!/FPGAProjects/StyleCam_camera/validation/in_math/
/FPGAProjects/StyleCam_camera/validation/in_math/*
!/FPGAProjects/StyleCam_camera/validation/in_math/result.json
!/FPGAProjects/StyleCam_camera/validation/camera_sim/
