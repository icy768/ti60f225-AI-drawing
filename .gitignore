# Local reference materials and tools
/DEMO/
/other/
/_tmp_pdf/
/.vscode/
*.pdf
*.log
**/__pycache__/
**/.venv/
**/data/
**/.metadata/
**/work*/
**/ooc/
**/validation/
**/outflow/
!FPGAProjects/sc431hai_hdmi/outflow/
FPGAProjects/sc431hai_hdmi/outflow/*
!FPGAProjects/sc431hai_hdmi/outflow/ti60f225_oob.bit

# Local training/build scratch directories
/FPGAProjects/StyleCam/runs/_rand/
/FPGAProjects/StyleCam/runs/backup_pe12_20260930/
/FPGAProjects/StyleCam/runs/c24_dw1_in/
/FPGAProjects/StyleCam/runs/c24_gram/
/FPGAProjects/StyleCam/runs/mosaic_a/
/FPGAProjects/StyleCam/runs/mosaic_b/
